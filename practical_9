      "source": [
        "# Prim's Algorithm\n",
        "\n",
        "INF = 999999\n",
        "\n",
        "# Graph represented using adjacency matrix\n",
        "graph = [\n",
        "    [0, 2, INF, 6, INF],\n",
        "    [2, 0, 3, 8, 5],\n",
        "    [INF, 3, 0, INF, 7],\n",
        "    [6, 8, INF, 0, 9],\n",
        "    [INF, 5, 7, 9, 0]\n",
        "]\n",
        "\n",
        "n = len(graph)\n",
        "\n",
        "selected = [False] * n\n",
        "selected[0] = True\n",
        "\n",
        "print(\"Edges in Minimum Spanning Tree:\")\n",
        "print(\"Edge\\tWeight\")\n",
        "\n",
        "for _ in range(n - 1):\n",
        "    minimum = INF\n",
        "    x = 0\n",
        "    y = 0\n",
        "\n",
        "    for i in range(n):\n",
        "        if selected[i]:\n",
        "            for j in range(n):\n",
        "                if not selected[j] and graph[i][j] < minimum:\n",
        "                    minimum = graph[i][j]\n",
        "                    x = i\n",
        "                    y = j\n",
        "\n",
        "    print(f\"{x} - {y}\\t{minimum}\")\n",
        "    selected[y] = True"
      ]
    }
  ]
